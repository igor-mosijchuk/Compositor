+                addCursorRect(rect, cursor: Self.cropResizeCursor(forRegion: region.index))
             }
         }
     }
+
+    /// Diagonal frame-resize cursors exist from macOS 15; macOS 14 gets plain horizontal, vertical and crosshair ones.
+    /// Region order: top left, top, top right, right, bottom right, bottom, bottom left, left.
+    private static func cropResizeCursor(forRegion index: Int) -> NSCursor {
+        if #available(macOS 15, *) {
+            let positions: [NSCursor.FrameResizePosition] = [.topLeft, .top, .topRight, .right, .bottomRight, .bottom, .bottomLeft, .left]
+            return .frameResize(position: positions[index], directions: [.inward, .outward])
+        }
+        switch index {
+        case 1, 5: return .resizeUpDown
+        case 3, 7: return .resizeLeftRight
+        default: return .crosshair
+        }
+    }
