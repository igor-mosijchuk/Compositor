--- a/Compositor/CompositorApp.swift
+++ b/Compositor/CompositorApp.swift
@@ -15,9 +15,7 @@ struct CompositorApp: App {
             .handlesExternalEvents(matching: [])
             // A first launch fills the screen (without going full screen); after that macOS reopens the window at the
             // size it was left.
-            .defaultWindowPlacement { _, context in
-                WindowPlacement(size: context.defaultDisplay.visibleRect.size)
-            }
+            .fillsScreenOnFirstLaunch()
             // The project's name is already on its tab, so the toolbar doesn't repeat it as a window title.
             .windowToolbarStyle(.unifiedCompact(showsTitle: false))
             .commands {
@@ -320,3 +318,16 @@ struct CompositorApp: App {
             }
     }
 }
+
+private extension Scene {
+    /// macOS 15+: open the first window at the visible screen size. On macOS 14 the default size applies instead.
+    @SceneBuilder func fillsScreenOnFirstLaunch() -> some Scene {
+        if #available(macOS 15, *) {
+            defaultWindowPlacement { _, context in
+                WindowPlacement(size: context.defaultDisplay.visibleRect.size)
+            }
+        } else {
+            self
+        }
+    }
+}
